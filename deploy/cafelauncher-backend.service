[Unit]
Description=CafeLauncher Backend API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cafelauncher
Group=cafelauncher
WorkingDirectory=/opt/cafelauncher-backend
EnvironmentFile=/etc/cafelauncher-backend.env
Environment=CAFELAUNCHER_DATA_DIR=/var/lib/cafelauncher-backend
Environment=CAFELAUNCHER_BIND=127.0.0.1
Environment=CAFELAUNCHER_PORT=8090
ExecStart=/usr/bin/python3 /opt/cafelauncher-backend/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cafelauncher-backend

[Install]
WantedBy=multi-user.target
